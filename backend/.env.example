# ── App ──────────────────────────────────────────────────────────
APP_NAME=JobAutomate
DEBUG=false

# ── Database ─────────────────────────────────────────────────────
# Replace with your actual credentials
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobautomate

# ── File Storage ─────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ── Job Aggregators: ATS Endpoints ───────────────────────────────
# Comma-separated Greenhouse board tokens (e.g. stripe,airbnb,notion)
GREENHOUSE_BOARD_TOKENS=stripe,airbnb,notion

# Comma-separated Lever company slugs (e.g. netflix,linear,vercel)
LEVER_COMPANY_SLUGS=netflix,linear,vercel

# ── Job Aggregators: Adzuna Free Developer API ───────────────────
# Sign up at https://developer.adzuna.com/ (free, no credit card required)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
ADZUNA_QUERY=software engineer
ADZUNA_LOCATION=pune

# ── Job Aggregators: Best-Effort Scrapers (LinkedIn & Naukri) ────
SCRAPER_QUERY=software engineer
SCRAPER_LOCATION=pune
SCRAPER_MAX_RESULTS=20

# ── Security & Scheduled Pipeline ────────────────────────────────
# API key required to trigger pipeline and protected admin operations
PIPELINE_API_KEY=
HTTP_TIMEOUT_SECONDS=15.0
