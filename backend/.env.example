# ── App ──────────────────────────────────────────────────────────
APP_NAME=JobAutomate
DEBUG=false

# ── Database ─────────────────────────────────────────────────────
# Replace with your actual credentials
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobautomate

# ── File Storage ─────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ── Job Aggregators ───────────────────────────────────────────────
# Comma-separated Greenhouse board tokens (no spaces)
# Example: GREENHOUSE_BOARD_TOKENS=stripe,airbnb,notion
GREENHOUSE_BOARD_TOKENS=

# Comma-separated Lever company slugs (no spaces)
# Example: LEVER_COMPANY_SLUGS=netflix,linear,vercel
LEVER_COMPANY_SLUGS=

# Timeout in seconds for outbound HTTP requests to ATS APIs
HTTP_TIMEOUT_SECONDS=15.0
